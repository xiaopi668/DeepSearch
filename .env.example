# ============================================================================
# DeepSearch 服务端配置示例
# 复制为 .env 后按需修改：cp .env.example .env
#
# 说明：本应用采用「访客自带 API Key」模式（BYOK）。
# 访客在网页「设置」里填写自己的 DeepSeek API Key，Key 只保存在浏览器
# localStorage，并在每次请求时通过 Authorization 头经本服务转发给 DeepSeek，
# 服务端不落盘、不打印、不共享任何 API Key。
# ============================================================================

# 监听地址与端口
HOST=0.0.0.0
PORT=8787

# 上游 DeepSeek API 地址（一般无需修改；如需走代理网关可改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 请求超时（毫秒）
SEARCH_TIMEOUT_MS=20000
FETCH_TIMEOUT_MS=60000
CHAT_TIMEOUT_MS=120000

# 单次请求体上限，例如 1mb
MAX_BODY_BYTES=1mb

# 按 IP 限流（滑动窗口）：窗口毫秒数 / 窗口内允许次数
RATE_LIMIT_WINDOW_MS=60000
SEARCH_RATE_LIMIT_MAX=90
FETCH_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_MAX=20

# 可选：部署到公网时额外加一道站点访问口令（空 = 关闭，默认关闭）
# 开启后页面会要求输入口令，前端通过 X-Access-Token 头携带。
ACCESS_TOKEN=

# 是否信任反向代理传来的 X-Forwarded-For（默认 0 = 不信任）。
#   - 直连暴露（pnpm start、docker run -p 8787:8787、compose 默认端口）必须保持 0，
#     否则访客可伪造 X-Forwarded-For 绕过按 IP 的限流。
#   - 前面有可信 Nginx/Caddy 时改为 1；更严格的做法是填代理网段，如 127.0.0.1/32。
TRUST_PROXY=0

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
